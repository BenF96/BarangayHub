# development | production
NODE_ENV=development
PORT=3000

# MongoDB connection string (local or Atlas). In Atlas, write "@" in the password as %40.
MONGODB_URI=mongodb://127.0.0.1:27017/barangay_rental

# Behind a reverse proxy / hosting platform (Nginx, Render, Railway…): set to 1
TRUST_PROXY=0

# Set to true only when the site is served over HTTPS (turns on HSTS)
HTTPS=false

# Time zone for "today", overdue and timestamps
TZ=Asia/Manila
